# Block direct web access to internal installer files -- only index.php
# (the wizard controller) is meant to be requested directly.
<FilesMatch "(\.sql$|\.lock$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
